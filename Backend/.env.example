PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=eloncred_app
DB_PASSWORD=replace-with-your-database-password
DB_NAME=eloncred_db

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Set to true when the site is served over HTTPS (e.g. in production behind a proxy)
COOKIE_SECURE=false

# Optional: comma-separated extra origins allowed to call the API (only needed if the
# frontend is NOT served by this Express server, e.g. http://127.0.0.1:8080 for live-server)
CORS_ORIGINS=
