PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=eloncred_app
DB_PASSWORD=replace-with-your-database-password
DB_NAME=eloncred_db

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Set to true when the site is served over HTTPS (e.g. in production behind a proxy)
COOKIE_SECURE=false

# Optional: comma-separated extra origins allowed to call the API (only needed if the
# frontend is NOT served by this Express server, e.g. http://127.0.0.1:8080 for live-server)
CORS_ORIGINS=

# ---------------------------------------------------------------
# M-Pesa Express (Daraja STK Push)
# Get keys at https://developer.safaricom.co.ke (create an app with "M-Pesa Express").
# ---------------------------------------------------------------
MPESA_ENV=sandbox                      # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox test values published by Safaricom; replace with your own Paybill/Till and passkey in production
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # CustomerBuyGoodsOnline for a Till number
MPESA_PARTY_B=                         # Till number when using Buy Goods; defaults to MPESA_SHORTCODE
# Long random string; it is part of the callback URL so only Safaricom (who knows the URL) can call it
MPESA_CALLBACK_SECRET=
# Must be public HTTPS. Locally, expose the server with e.g. `ngrok http 3000`.
MPESA_CALLBACK_URL=https://your-domain.example/api/mpesa/callback/<MPESA_CALLBACK_SECRET>
